package provide SimileAutoObj 1.1
# 1.0 for Simile 4.0
# 1.1 for Simile 4.1

# Notes
# must be pipe interface

package require Itcl

# Attempting to make it work without Tk -- next line failed to load it anyway
# package require Tk

if {[string match windows $tcl_platform(platform)]} {
# removed until I can get hold of a 64-bit version
#     package require tcom
#     ::tcom::import [file join [file dirname [info script]] SimileAutoObj.tlb]
}
set ::SimileAutoObjLoaded true; # used so .register (welcome) dialog not produced
set env(LD_LIBRARY_PATH) "[file dirname [info script]]/../../../System/lib"
if {![info exists window_info]} {
    set argc 1; # simile.tcl expects to be called from the command line -- 
# the '-stealth' arg allows other instances of Simile to run independently
    set argv {-stealth}
    source "[file dirname [info script]]/../../../Run/simile.tcl"
    
# The following was done to allow Simile's normal quit procedure to be
# followed when the script executed the 'exit' command. It is now
# unnecessary, since model execution runs in a separate thread rather
# than a separate application and therefore exits automatically as
# soon as the parent thread does. It is also useless since dialogues
# are short-circuited during scripting so there is no opportunity to
# save an altered model (not that scripts can alter them) anyway.

#     rename exit ::renamed::exit
#     proc exit {} {
#         catch {prolog tk_kill_everything(_)}
# 	puts $::errorInfo
#     }
    
