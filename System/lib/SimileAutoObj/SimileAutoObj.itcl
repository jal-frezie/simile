class TableHelperImpl {
    variable winId;    #Tk path to Table helper window
    variable keyvalue; # Table helper namespace
    variable modelNode node00000
    
    constructor {modelWindow} {
        global runState
        global helperTable
        set keyvalue tabular11510
        set winId [$modelWindow CreateHelperWindow $keyvalue {Table}]
        Hide
        SetUpdateAtDisplayInterval false
    }
    
    destructor {
        destroy $winId
    }
    
    public method Show {} {
        wm deiconify $winId
    }
    
    public method Hide {} {
        wm withdraw $winId
    }
    
    public method AddVariable {path} {
        global helperTable
        set helperTable(node00000,current) $winId
        ${keyvalue}::click $winId [GetIdFromCaptionPath $winId $path] $path
    }
    
    public method RemoveVariable {path} {
        set var $path; # prop needs nodeId TODO
        ${keyvalue}::Remove $winId $var
    }
    
    public method Clear {} {
        $keyvalue::clear
    }
    
    public method SetUpdateAtDisplayInterval {value} {
        set ${keyvalue}::displayUpdate($winId) $value
    }
    
    public method GetUpdateAtDisplayInterval {} {
        return  ${keyvalue}::displayUpdate($winId)
    }
    
    public method Update {} {
        ${keyvalue}::Update $winId
    }
    
    public method SaveToFile {filename} {
        Update
        ${keyvalue}::SaveToNamedFile $winId $filename
    }
    
}

if {[string match windows $tcl_platform(platform)]} {
    ::tcom::object registerfactory ::SimileAutoObj::ModelWindow {ModelWindowImpl #auto} {delete object}
}

