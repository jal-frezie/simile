# box
$c add rectangle $g "-15 -15 15 15" -filled 1 -linewidth 0 -tags unscaled
$c add curve $g [list "-15 -15" "-15 15" "15 15" "15 -15"] -closed true \
	-tags "unscaled size_on_this realwidth(1.0)"

$c add text $g -position "0 0" -text {?} -composescale 1 -tags unscaled \
	-font {-family Helvetica -weight bold -slant roman -size 16} -anchor c
# query

