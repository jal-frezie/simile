# box
$c add rectangle $g "-15 -15 15 15" -filled 1 -linewidth 0 -tags unscaled
$c add curve $g [list "-15 -15" "-15 15" "15 15" "15 -15"] -closed true \
	-tags "unscaled size_on_this"

$c add curve $g [list "-13 5" "13 5"] -linewidth 2.5 -tags "unscaled"

# following replaced by smooth line cos arcs don't stipple
# $c create arc -10 -2 10 18 -start 15 -extent 150 -style arc
$c add curve $g [list "-10 5" "-4 -7 c" "4 -7 c" "10 5"] \
	-linewidth 2.5 -tags "unscaled"

$c add curve $g [list "-8 -1" "-12 -5"] -linewidth 2.5 -tags "unscaled"
$c add curve $g [list "-0 -4" "0 -10"] -linewidth 2.5 -tags "unscaled"
$c add curve $g [list "8 -2" "12 -6"] -linewidth 2.5 -tags "unscaled"
